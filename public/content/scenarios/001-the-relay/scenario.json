{
  "version": 1,
  "title": "The Relay",
  "introduction": "Local session open.",
  "roles": ["guest", "maintenance"],
  "flags": [],
  "local": {
    "user": "guest",
    "role": "guest"
  },
  "hosts": [
    {
      "id": "relay-07",
      "name": "MONONYM legacy message relay",
      "guest": {
        "user": "guest",
        "role": "guest"
      },
      "welcome": "Guest session opened.",
      "resources": [
        {
          "id": "manual",
          "path": "/README",
          "type": "file",
          "content": "files/README.txt"
        },
        {
          "id": "notes",
          "path": "/notes",
          "type": "directory"
        },
        {
          "id": "keypad",
          "path": "/notes/keypad.txt",
          "type": "file",
          "content": "files/keypad.txt",
          "inspectLines": [3, 4]
        },
        {
          "id": "queue",
          "path": "/queue",
          "type": "directory"
        },
        {
          "id": "incident",
          "path": "/queue/8c2f.msg",
          "type": "file",
          "content": "files/8c2f.msg",
          "access": {
            "roles": ["maintenance"]
          },
          "denied": "Permission denied: /queue/8c2f.msg requires maintenance access."
        },
        {
          "id": "mail",
          "path": "/mail",
          "type": "directory"
        },
        {
          "id": "old-consoles",
          "path": "/mail/old-consoles",
          "type": "mail",
          "content": "mail/old-consoles.json"
        },
        {
          "id": "login-compatibility",
          "path": "/mail/login-compatibility",
          "type": "mail",
          "content": "mail/login-compatibility.json"
        },
        {
          "id": "maintenance-policy",
          "path": "/mail/maintenance-policy",
          "type": "mail",
          "content": "mail/maintenance-policy.json"
        }
      ],
      "login": {
        "label": "Account alias",
        "puzzle": "puzzle.json",
        "input": "alias",
        "access": { "roles": ["guest"] },
        "success": [
          {
            "type": "session",
            "identity": {
              "user": "MAINT",
              "role": "maintenance"
            }
          },
          {
            "type": "message",
            "text": "Authentication accepted. Resolved identity: MAINT. Session elevated."
          }
        ],
        "failure": "Login rejected. Account not found.",
        "rejected": [
          {
            "check": "raw_reserved",
            "message": "Login rejected. Reserved account name."
          },
          {
            "check": "canonical_reserved",
            "message": "Login rejected. Reserved account name."
          }
        ]
      }
    }
  ],
  "objective": {
    "text": "Retrieve incident 8C2F from the protected queue.",
    "read": "incident",
    "message": "Incident 8C2F retrieved. Objective complete."
  },
  "inbox": {
    "content": "mail/inbox.json",
    "initial": ["favor"]
  }
}
