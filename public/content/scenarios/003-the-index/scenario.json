        {
          "id": "exports",
          "path": "/exports",
          "type": "directory"
        },
        {
          "id": "originals",
          "path": "/exports/8c2f-originals.json",
          "type": "file",
          "content": "files/8c2f-originals.json",
          "inspectNotation": true,
          "access": {
            "flag": "export_ready"
          },
          "denied": "Original identifiers are restricted. Verify the source registrations before requesting the export."
        }
      ],
      "operations": [
        {
          "command": "reconcile",
          "label": "Candidate identifier",
          "actionLabel": "Reconcile identifier",
          "submitLabel": "Submit query",
          "puzzle": "puzzle.json",
          "input": "candidate",
          "initial": "Mira",
          "access": {
            "roles": ["auditor"]
          },
          "success": [
            {
              "type": "flag",
              "flag": "bucket_found"
            },
            {
              "type": "message",
              "text": "Collision detected. Index bucket: 8C2F. Canonical records: 1. Source registrations: 2.\nOriginal identifiers: REDACTED. Ownership reconstruction required."
            },
            {
              "type": "resourceLink",
              "resource": "bucket"
            }
          ],
          "failure": "Query rejected. No matching collision record.",
          "rejected": [
            {
              "check": "ordinary_filter",
              "message": "Query rejected. Protected canonical identifier."
            }
          ]
        },
        {
          "command": "reconstruct",
          "label": "Ownership reconstruction",
          "actionLabel": "Reconstruct owners",
          "submitLabel": "Verify originals",
          "puzzle": "reconstruction.json",
          "access": {
            "roles": ["auditor"],
            "flag": "bucket_found"
          },
          "fields": [
            {
              "input": "id_a",
              "label": "Record A",
              "fixed": "0001842"
            },
            {
              "input": "name_a",
              "label": "Original name A"
            },
            {
              "input": "id_b",
              "label": "Record B",
              "fixed": "0002917"
            },
            {
              "input": "name_b",
              "label": "Original name B"
            }
          ],
          "success": [
            {
              "type": "flag",
              "flag": "export_ready"
            },
            {
              "type": "message",
              "text": "Reconstruction verified. Source registrations: 2. Independent owners: 2. Canonical index entries: 1."
            },
            {
              "type": "resourceLink",
              "resource": "originals"
            }
          ],
          "failure": "Reconstruction rejected.",
          "rejected": [
            {
              "check": "owners",
              "message": "Ownership records could not be verified."
            },
            {
              "check": "distinct_names",
              "message": "Reconstruction rejected. The source records have distinct spellings."
            },
            {
              "check": "key_a",
              "message": "Registration A: spelling does not belong to this collision bucket."
            },
            {
              "check": "key_b",
              "message": "Registration B: spelling does not belong to this collision bucket."
            },
            {
              "check": "exact_a",
              "message": "Registration A: spelling differs from the verified source."
            },
            {
              "check": "exact_b",
              "message": "Registration B: spelling differs from the verified source."
            }
          ]
        }
      ]
    }
  ],
  "objective": {
    "text": "Recover the original identity mapping for incident 8C2F.",
    "read": "originals",
    "message": "Original registrations recovered for incident 8C2F. Objective complete.",
    "onComplete": [
