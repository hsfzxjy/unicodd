{
  "version": 1,
  "title": "Dead Letter",
  "introduction": "The relay handed off Mira’s missing notice, 2917. Postbox placed it on hold.",
  "outputTiming": {
    "route": [
      {
        "afterRows": 0,
        "minMs": 100,
        "maxMs": 220
      }
    ]
  },
  "roles": ["guest"],
  "flags": ["released"],
  "local": {
    "user": "operator",
    "role": "guest"
  },
  "initialHost": "postbox-03",
  "hosts": [
    {
      "id": "postbox-03",
      "name": "Legacy mail gateway",
      "guest": {
        "user": "guest",
        "role": "guest"
      },
      "welcome": "The delivery queue holds messages waiting to be sent. This hold keeps recovery messages from reaching the wrong account owner.",
      "status": [
        {
          "label": "Notice 2917",
          "value": "Delivery paused",
          "after": {
            "flag": "released",
            "value": "Released for delivery"
          },
          "description": "A paused notice stays in the delivery queue. Release makes it available for delivery."
        },
        {
          "label": "Router version",
          "value": "2.8.1-r1"
        }
      ],
      "resources": [
        {
          "id": "readme",
          "path": "/README",
          "type": "file",
          "content": "files/README.txt"
        },
        {
          "id": "mail",
          "path": "/mail",
          "type": "directory"
        },
        {
          "id": "hold",
          "path": "/mail/01-delivery-hold",
          "type": "mail",
          "content": "mail/delivery-hold.json"
        },
        {
          "id": "import",
          "path": "/mail/02-contact-import",
          "type": "mail",
          "content": "mail/contact-import.json"
        },
        {
          "id": "review",
          "path": "/mail/03-queue-review",
          "type": "mail",
          "content": "mail/queue-review.json"
        },
        {
          "id": "envelope_protocol",
          "path": "/mail/04-envelope-field",
          "type": "mail",
          "content": "mail/envelope-field.json"
        },
        {
          "id": "samples",
          "path": "/samples",
          "type": "directory"
        },
        {
          "id": "sample",
          "path": "/samples/legacy-address.txt",
          "type": "file",
          "content": "files/legacy-address.txt",
          "inspectNotation": true
        },
        {
          "id": "address_card",
          "path": "/samples/address-card.txt",
          "type": "file",
          "content": "files/address-card.txt",
          "inspectLines": [4]
        },
        {
          "id": "spool",
          "path": "/spool",
          "type": "directory"
        },
        {
          "id": "metadata",
          "path": "/spool/2917.msg",
          "type": "file",
          "content": "files/2917-queue.txt",
          "format": "evidence"
        },
        {
          "id": "deployments",
          "path": "/spool/router-history.txt",
          "type": "file",
          "content": "files/router-history.txt",
          "format": "log"
        },
        {
          "id": "delivered",
          "path": "/delivered",
          "type": "directory"
        },
        {
          "id": "body",
          "path": "/delivered/2917.msg",
          "type": "mail",
          "content": "mail/2917.json",
          "access": {
            "flag": "released"
          },
          "denied": "Message 2917 is still quarantined."
        }
      ],
      "operation": {
        "command": "route",
        "label": "Recipient",
        "actionLabel": "Route message",
        "submitLabel": "Submit route",
        "puzzle": "puzzle.json",
        "success": [
          {
            "type": "flag",
            "flag": "released",
            "milestone": {
              "id": "notice-released",
              "title": "Notice 2917 released",
              "text": "Quarantined → Released. The message is available in the delivery queue."
            }
          },
          {
            "type": "message",
            "text": "Route accepted. Resolved recipient: Mira. Message released from quarantine."
          },
          {
            "type": "resourceLink",
            "resource": "body"
          }
        ],
        "failure": "Routing rejected. Resolved header and envelope recipients differ.",
        "rejected": [
          {
            "check": "delivery_hold",
            "message": "Header quarantine: recipient is under delivery hold.",
            "stage": "header"
          },
          {
            "check": "header_resolves",
            "message": "Header cleanup: recipient could not be resolved.",
            "stage": "header"
          },
          {
            "check": "header_bytes",
            "message": "Header replay: byte length differs from the captured header.",
            "stage": "header"
          },
          {
            "check": "envelope_reserved",
            "message": "Envelope gateway: canonical recipient is restricted on manual routes.",
            "stage": "envelope"
          },
          {
            "check": "envelope_capacity",
            "message": "Envelope transport: recipient exceeds six UTF-8 bytes.",
            "stage": "envelope"
          },
          {
            "check": "envelope_resolves",
            "message": "Envelope lookup: recipient could not be resolved.",
            "stage": "envelope"
          }
        ],
        "fields": [
          {
            "input": "header",
            "label": "Header recipient",
            "initial": "Mira"
          },
          {
            "input": "envelope",
            "label": "Envelope recipient",
            "initial": "Mira"
          }
        ]
      }
    }
  ],
  "objective": {
    "text": "Recover and read Mira’s missing delivery notice, 2917.",
    "read": "body",
    "message": "Notice 2917 recovered. Its sender reports receiving Mira’s account notifications.",
    "completionBand": true,
    "onComplete": [
      {
        "type": "deliverMail",
        "message": "missing-notice-reply"
      },
      {
        "type": "discover",
        "scenario": "003-the-index"
      }
    ]
  },
  "inbox": {
    "content": "mail/inbox.json",
    "initial": []
  }
}
