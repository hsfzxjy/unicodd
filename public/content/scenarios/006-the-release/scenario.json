            {
              "input": "key",
              "label": "Identity key",
              "initial": "skeleton",
              "kind": "text"
            },
            {
              "input": "originals",
              "label": "Original names",
              "initial": "preserve",
              "kind": "text"
            }
          ],
          "success": [
            {
              "type": "flag",
              "flag": "plan_prepared"
            },
            {
              "type": "clearFlag",
              "flag": "preview_ready"
            },
            {
              "type": "clearFlag",
              "flag": "plan_verified"
            },
            {
              "type": "message",
              "text": "Identity mapping staged. Run an audit preview for this plan."
