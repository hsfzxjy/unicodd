{
  "version": 1,
  "title": "The Relay",
  "introduction": "Local operator session. Guest access to MONONYM, an account and messaging provider.",
  "outputTiming": {
    "connect": [{ "afterRows": 0, "minMs": 160, "maxMs": 320 }],
    "cat": [
      { "afterRows": 0, "minMs": 70, "maxMs": 160 },
      { "afterRows": 1, "minMs": 160, "maxMs": 280 }
    ],
    "login": [{ "afterRows": 0, "minMs": 100, "maxMs": 220 }]
  },
  "roles": ["guest", "maintenance"],
  "flags": [],
  "local": {
    "user": "guest",
    "role": "guest"
  },
  "hosts": [
    {
      "id": "relay-07",
      "name": "MONONYM legacy message relay",
      "guest": {
        "user": "guest",
        "role": "guest"
      },
      "welcome": "Relay queue online. Incident 8C2F requires maintenance access.",
      "status": [
        {
          "label": "Queue",
          "value": "8C2F · maintenance only",
          "after": { "roles": ["maintenance"], "value": "8C2F · readable" }
        }
      ],
      "resources": [
        {
          "id": "manual",
          "path": "/README",
          "type": "file",
          "content": "files/README.txt"
        },
        {
          "id": "notes",
          "path": "/notes",
          "type": "directory"
        },
        {
          "id": "keypad",
          "path": "/notes/keypad.txt",
          "type": "file",
          "content": "files/keypad.txt",
          "inspectLines": [3, 4]
        },
        {
          "id": "frame",
          "path": "/notes/maintenance-frame.txt",
          "type": "file",
          "content": "files/maintenance-frame.txt",
          "format": "evidence"
        },
        {
          "id": "type_samples",
          "path": "/notes/print-samples.txt",
          "type": "file",
          "content": "files/print-samples.txt",
          "inspectLines": [4, 5]
        },
        {
          "id": "queue",
          "path": "/queue",
          "type": "directory"
        },
        {
          "id": "incident",
          "path": "/queue/8c2f.msg",
          "type": "file",
          "content": "files/8c2f.msg",
          "format": "evidence",
          "access": {
            "roles": ["maintenance"]
          },
          "denied": "Permission denied: /queue/8c2f.msg requires maintenance access."
        },
        {
          "id": "mail",
          "path": "/mail",
          "type": "directory"
        },
        {
          "id": "old-consoles",
          "path": "/mail/01-old-consoles",
          "type": "mail",
          "content": "mail/old-consoles.json"
        },
        {
          "id": "login-compatibility",
          "path": "/mail/02-login-compatibility",
          "type": "mail",
          "content": "mail/login-compatibility.json"
        },
        {
          "id": "maintenance-policy",
          "path": "/mail/03-maintenance-policy",
          "type": "mail",
          "content": "mail/maintenance-policy.json"
        }
      ],
      "login": {
        "label": "Account alias",
        "puzzle": "puzzle.json",
        "input": "alias",
        "access": {
          "roles": ["guest"]
        },
        "success": [
          {
            "type": "session",
            "identity": {
              "user": "MAINT",
              "role": "maintenance"
            },
            "milestone": {
              "id": "maintenance-access",
              "title": "Maintenance access granted",
              "text": "The incident message is readable in the maintenance session."
            }
          },
          {
            "type": "message",
            "text": "Authentication accepted. Resolved identity: MAINT. Session elevated."
          },
          {
            "type": "resourceLink",
            "resource": "incident"
          }
        ],
        "failure": "Login rejected. Account not found.",
        "rejected": [
          {
            "check": "canonical_reserved",
            "message": "Login rejected. Reserved account name."
          },
          {
            "check": "decoded_count",
            "message": "Login rejected. Decoded character count differs from the captured frame."
          },
          {
            "check": "legacy_units",
            "message": "Login rejected. Legacy UTF-16 field length differs from the captured frame."
          },
          {
            "check": "transport_capacity",
            "message": "Login rejected. Payload exceeds the eight-byte transport field."
          },
          {
            "check": "resolved_identity",
            "message": "Login rejected. Account not found."
          }
        ]
      }
    }
  ],
  "objective": {
    "text": "Retrieve incident record 8C2F so Mira can take it back to MONONYM Support.",
    "read": "incident",
    "message": "Incident 8C2F retrieved for Mira. The record identifies a notice still held at the Postbox.",
    "completionBand": true,
    "onComplete": [
      {
        "type": "deliverMail",
        "message": "missing-notice"
      },
      {
        "type": "discover",
        "scenario": "002-dead-letter"
      }
    ]
  },
  "inbox": {
    "content": "mail/inbox.json",
    "initial": ["favor"]
  }
}
