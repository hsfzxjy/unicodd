{
  "version": 1,
  "title": "The Parcel",
  "introduction": "The public copy is approved. The receivers get different results from the same filenames.",
  "roles": ["delivery-operator"],
  "flags": ["delivery_verified"],
  "local": {
    "user": "delivery-operator",
    "role": "delivery-operator"
  },
  "initialHost": "bundle-17",
  "dossier": {
    "dataset": "dossier/summer-duty.json",
    "prior": "011-the-mask"
  },
  "hosts": [
    {
      "id": "bundle-17",
      "name": "MONONYM delivery sandbox",
      "guest": {
        "user": "delivery-operator",
        "role": "delivery-operator"
      },
      "welcome": "Delivery sandbox. Trials use the approved assets in isolated trees.",
      "status": [
        {
          "label": "Receiver readback",
          "value": "Readback pending",
          "after": {
            "flag": "delivery_verified",
            "value": "Verified on all three receivers"
          },
          "description": "Each receiver must open every approved file and confirm its source reference."
        }
      ],
      "resources": [
        {
          "id": "mail",
          "path": "/mail",
          "type": "directory"
        },
        {
          "id": "tools",
          "path": "/tools",
          "type": "directory"
        },
        {
          "id": "logs",
          "path": "/logs",
          "type": "directory"
        },
        {
          "id": "reports",
          "path": "/reports",
          "type": "directory"
        },
        {
          "id": "readme",
          "path": "/README",
          "type": "file",
          "content": "files/readme.txt"
        },
        {
          "id": "profiles",
          "path": "/tools/targets.txt",
          "type": "file",
          "content": "files/profiles.txt"
        },
        {
          "id": "mapping",
          "path": "/tools/mapping.txt",
          "type": "file",
          "content": "files/mapping.txt"
        },
        {
          "id": "sandbox",
          "path": "/logs/trial-fixtures.txt",
          "type": "file",
          "content": "files/sandbox.txt"
        },
        {
          "id": "final-report",
          "path": "/reports/delivery.txt",
          "type": "file",
          "content": "files/final-report.txt",
          "access": {
            "flag": "delivery_verified"
          },
          "denied": "Delivery report is unavailable until receiver readback passes."
        },
        {
          "id": "01-names",
          "path": "/mail/01-names",
          "type": "mail",
          "content": "mail/01-names.json"
        },
        {
          "id": "02-digests",
          "path": "/mail/02-digests",
          "type": "mail",
          "content": "mail/02-digests.json"
        },
        {
          "id": "03-receivers",
          "path": "/mail/03-receivers",
          "type": "mail",
          "content": "mail/03-receivers.json"
        }
      ],
      "recovery": [
        {
          "command": "targets",
          "actionLabel": "Show extraction targets",
          "label": "Show extraction targets",
          "submitLabel": "Run targets",
          "fields": [],
          "quick": true,
          "success": [],
          "failure": "The current attempt did not pass review."
        },
        {
          "command": "assets",
          "actionLabel": "Read approved assets",
          "label": "Read approved assets",
          "submitLabel": "Run assets",
          "fields": [
            {
              "input": "file",
              "label": "Public file",
              "initial": "all",
              "kind": "text"
            }
          ],
          "quick": true,
          "success": [],
          "failure": "The current attempt did not pass review."
        },
        {
          "command": "probe-path",
          "actionLabel": "Trace a target path",
          "label": "Trace a target path",
          "submitLabel": "Run probe-path",
          "fields": [
            {
              "input": "target",
              "label": "Target",
              "initial": "win32-compat",
              "kind": "text"
            },
            {
              "input": "transform",
              "label": "Transform",
              "initial": "raw",
              "kind": "text"
            },
            {
              "input": "path",
              "inspectors": ["utf-8", "utf-16", "code-points"],
              "label": "Path",
              "initial": "NUL.txt",
              "kind": "payload"
            }
          ],
          "quick": true,
          "success": [],
          "failure": "The current attempt did not pass review."
        },
        {
          "command": "extract",
          "actionLabel": "Stage virtual extraction",
          "label": "Stage virtual extraction",
          "submitLabel": "Run extract",
          "fields": [
            {
              "input": "target",
              "label": "Target",
              "initial": "all",
              "kind": "text"
            },
            {
              "input": "mapping",
              "label": "Mapping",
              "initial": "raw",
              "kind": "payload"
            }
          ],
          "quick": true,
          "success": [
            {
              "type": "message",
              "text": "Sandbox trial staged. Receiver readback is pending."
            }
          ],
          "failure": "This sandbox extraction trial was rejected.",
          "invalidates": ["delivery_verified"]
        },
        {
          "command": "roundtrip",
          "actionLabel": "Verify restored bundle",
          "label": "Verify restored bundle",
          "submitLabel": "Run roundtrip",
          "fields": [],
          "quick": true,
          "success": [
            {
              "type": "flag",
              "flag": "delivery_verified",
              "milestone": {
                "id": "roundtrip-verified",
                "title": "Receiver readback verified",
                "text": "All three receivers matched every approved source reference and payload."
              }
            },
            {
              "type": "resourceLink",
              "resource": "final-report"
            }
          ],
          "failure": "Readback verification failed for this parcel trial.",
          "invalidates": ["delivery_verified"]
        }
      ]
    }
  ],
  "objective": {
    "text": "Verify all approved files on all three receivers, then read the delivery report.",
    "read": "final-report",
    "dossier": "bundle",
    "message": "Delivery logged. The approved dossier is with the client team.",
    "onComplete": [
      {
        "type": "deliverMail",
        "message": "dossier-delivered"
      }
    ],
    "completionBand": true
  },
  "inbox": {
    "content": "mail/inbox.json",
    "initial": ["dossier-delivery"]
  }
}
