      "recovery": [
        {
          "command": "prepare",
          "actionLabel": "Prepare split",
          "submitLabel": "Run prepare",
          "label": "Prepare split",
          "fields": [
            {
              "input": "key",
              "label": "Identity key",
              "initial": "skeleton",
              "kind": "text"
            },
            {
              "input": "originals",
              "label": "Original names",
              "initial": "preserve",
              "kind": "text"
            }
          ],
          "success": [
            {
              "type": "flag",
              "flag": "plan_prepared",
              "milestone": {
                "id": "repair-plan",
                "title": "Repair plan staged",
                "text": "The two originals and their owner associations are ready for audit."
              }
            },
            {
              "type": "clearFlag",
              "flag": "preview_ready"
            },
            {
              "type": "clearFlag",
              "flag": "plan_verified"
            },
            {
              "type": "message",
              "text": "Identity mapping staged."
            }
          ],
          "failure": "The host rejected this operation.",
          "quick": true,
          "rejected": [
            {
              "check": "originals",
              "stage": "identity",
              "message": "The proposed policy changes an original code-point sequence."
            },
            {
              "check": "independent-owners",
              "stage": "identity",
              "message": "The source owner records are not independent."
            },
            {
              "check": "identity-unique",
              "stage": "identity",
              "message": "The identity key collides across distinct registrations."
            },
            {
              "check": "approvals",
              "stage": "consent",
              "message": "The authorization handoff is missing or does not match both owners."
            }
          ]
        },
        {
          "command": "preview",
          "actionLabel": "Audit preview",
          "submitLabel": "Run preview",
          "label": "Audit preview",
          "fields": [
            {
              "input": "units",
              "label": "Limit units",
              "initial": "utf16",
              "kind": "text"
            },
            {
              "input": "limit",
              "label": "Field limit",
              "initial": "4",
              "kind": "text"
            },
            {
              "input": "bidi",
              "label": "Bidi policy",
              "initial": "raw",
              "kind": "text"
            },
            {
              "input": "controls",
              "label": "Controls",
              "initial": "raw",
              "kind": "text"
            }
          ],
          "success": [
            {
              "type": "flag",
              "flag": "preview_ready",
              "milestone": {
                "id": "audit-preview",
                "title": "Audit preview passed",
                "text": "The audit line preserves the field boundaries and fits the byte limit."
              }
            },
            {
              "type": "message",
              "text": "The audit samples passed the display and capacity checks."
            }
          ],
          "failure": "The host rejected this operation.",
          "quick": true,
          "invalidates": ["preview_ready", "plan_verified"],
          "rejected": [
            {
              "check": "plan-required",
              "stage": "plan",
              "message": "Stage a valid identity mapping before accepting a preview."
            },
            {
              "check": "valid-encoding",
              "stage": "preview",
              "message": "A cut produced invalid UTF-16."
            },
            {
              "check": "grapheme-boundary",
              "stage": "preview",
              "message": "A preview lost a required cluster or cut inside one."
            },
            {
              "check": "byte-capacity",
              "stage": "capacity",
              "message": "A serialized audit line exceeds its UTF-8 capacity."
            },
            {
              "check": "bidi-isolation",
              "stage": "bidi",
              "message": "The serialization does not isolate the field after truncation."
            },
            {
              "check": "formatting-controls",
              "stage": "controls",
              "message": "A formatting control needs a visible, safe representation."
            }
          ]
        },
        {
          "command": "verify",
          "actionLabel": "Verify dry run",
          "submitLabel": "Run verify",
