          "content": "mail/source-records.json"
        },
        {
          "id": "support",
          "path": "/mail/03-support-escalation",
          "type": "mail",
          "content": "mail/support-escalation.json"
        },
        {
          "id": "audit",
          "path": "/audit",
          "type": "directory"
        },
        {
          "id": "summary",
          "path": "/audit/8c2f.summary",
          "type": "file",
          "content": "files/8c2f.summary",
          "inspectLines": [7]
        },
        {
          "id": "review",
          "path": "/audit/identifier-review.txt",
          "type": "file",
          "content": "files/identifier-review.txt"
        },
        {
          "id": "encoding_log",
          "path": "/audit/encoding.log",
          "type": "file",
          "content": "files/encoding.log"
        },
        {
          "id": "difference",
