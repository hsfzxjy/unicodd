          "type": "file",
          "content": "files/byte-difference.txt"
        },
        {
          "id": "tools",
          "path": "/tools",
          "type": "directory"
        },
        {
          "id": "diagnostic",
          "path": "/tools/reconcile.txt",
          "type": "file",
          "content": "files/reconcile.txt"
        },
        {
          "id": "bucket",
          "path": "/tools/bucket-8c2f.txt",
