{
  "name": "unicodd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build:assets",
    "dev": "vite",
    "preview": "vite preview",
    "build:assets": "npm run build:wasm && npm run build:unicode-index",
    "build:wasm": "node tools/build-wasm.mjs",
    "build:unicode-index": "node tools/build-unicode-index.mjs",
    "prebuild": "npm run build:assets",
    "build": "vue-tsc -b && vite build",
    "size:check": "node tools/check-size-budget.mjs",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build:assets",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@vue-flow/core": "1.48.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/dagre": "0.7.54",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
