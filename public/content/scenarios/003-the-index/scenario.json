            "flag": "bucket_found",
            "value": "Located"
          }
        },
        {
          "label": "Export",
          "value": "Restricted",
          "after": {
            "flag": "export_ready",
            "value": "Available"
          }
        }
      ],
      "resources": [
        {
          "id": "readme",
          "path": "/README",
          "type": "file",
