{
  "version": 1,
  "title": "The Release",
  "introduction": "Both owners gave consent. Audit paused release over the printout.",
  "outputTiming": {
    "verify": [
      {
        "afterRows": 0,
        "minMs": 160,
        "maxMs": 300
      }
    ],
    "commit": [
      {
        "afterRows": 0,
        "minMs": 160,
        "maxMs": 300
      },
      {
        "afterRows": 1,
        "minMs": 180,
        "maxMs": 340
      }
    ]
  },
  "roles": ["recovery-operator"],
  "flags": ["plan_prepared", "preview_ready", "plan_verified", "released"],
  "local": {
    "user": "recovery-operator",
    "role": "recovery-operator"
  },
  "initialHost": "audit-06",
  "recovery": {
    "dataset": "recovery/8c2f.json",
    "source": "scenarios/003-the-index/files/8c2f-originals.json",
    "prior": "005-the-handshake",
    "archive": "recovery/archive-8c2f.json"
  },
  "hosts": [
    {
      "id": "audit-06",
      "name": "MONONYM recovery audit",
      "guest": {
        "user": "recovery-operator",
        "role": "recovery-operator"
      },
      "welcome": "Restricted release session. Two registrations in scope.",
      "status": [
        {
          "label": "Incident",
          "value": "8C2F"
        },
        {
          "label": "Split plan",
          "value": "No mapping staged",
          "after": {
            "flag": "plan_prepared",
            "value": "Both mappings staged"
          }
        },
        {
          "label": "Audit preview",
          "value": "Display and capacity checks pending",
          "after": {
            "flag": "preview_ready",
            "value": "Display and capacity checks passed"
          }
        },
        {
          "label": "Dry run",
          "value": "Current plan not verified",
          "after": {
            "flag": "plan_verified",
            "value": "Current plan verified"
          },
          "description": "Checks the plan, approvals, preview and rollback readiness without applying the split."
        },
        {
          "label": "Account split",
          "value": "Changes not applied",
          "after": {
            "flag": "released",
            "value": "Accounts separated"
          }
        }
      ],
      "resources": [
        {
          "id": "readme",
          "path": "/README",
          "type": "file",
          "content": "files/README.txt"
        },
        {
          "id": "plans",
          "path": "/plans",
          "type": "directory"
        },
        {
          "id": "scope",
          "path": "/plans/8c2f.txt",
          "type": "file",
          "content": "files/scope.txt",
          "inspectNotation": true
        },
        {
          "id": "samples",
          "path": "/samples",
          "type": "directory"
        },
        {
          "id": "audit-samples",
          "path": "/samples/preview.txt",
          "type": "file",
          "content": "files/preview.txt",
          "inspectLines": [3, 4, 5]
        },
        {
          "id": "control-samples",
          "path": "/samples/controls.txt",
          "type": "file",
          "content": "files/controls.txt",
          "inspectNotation": true
        },
        {
          "id": "logs",
          "path": "/logs",
          "type": "directory"
        },
        {
          "id": "versions",
          "path": "/logs/audit-history.log",
          "type": "file",
          "content": "files/audit-history.log"
        },
        {
          "id": "tools",
          "path": "/tools",
          "type": "directory"
        },
        {
          "id": "audit-help",
          "path": "/tools/recovery.txt",
          "type": "file",
          "content": "files/recovery.txt"
        },
        {
          "id": "archive",
          "path": "/mail",
          "type": "directory"
        },
        {
          "id": "01-preview-fix",
          "path": "/mail/01-preview-fix",
          "type": "mail",
          "content": "mail/01-preview-fix.json"
        },
        {
          "id": "02-preview-review",
          "path": "/mail/02-preview-review",
          "type": "mail",
          "content": "mail/02-preview-review.json"
        },
        {
          "id": "03-printout",
          "path": "/mail/03-printout",
          "type": "mail",
          "content": "mail/03-printout.json"
        },
        {
          "id": "04-release-conditions",
          "path": "/mail/04-release-conditions",
          "type": "mail",
          "content": "mail/04-release-conditions.json"
        }
