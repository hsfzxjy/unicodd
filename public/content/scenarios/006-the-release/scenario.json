              "initial": "4",
              "kind": "text"
            },
            {
              "input": "bidi",
              "label": "Bidi policy",
              "initial": "raw",
              "kind": "text"
            },
            {
              "input": "controls",
              "label": "Controls",
              "initial": "raw",
              "kind": "text"
