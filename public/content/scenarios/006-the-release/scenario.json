          "after": {
            "flag": "plan_prepared",
            "value": "Staged"
          }
        },
        {
          "label": "Preview",
          "value": "Unverified",
          "after": {
            "flag": "preview_ready",
            "value": "Passed"
          }
        },
        {
          "label": "Dry run",
          "value": "Blocked",
          "after": {
            "flag": "plan_verified",
            "value": "Verified"
          }
        },
        {
          "label": "Recovery",
          "value": "Pending",
